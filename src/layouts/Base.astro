---
/**
 * Every page is a Clarity page. The template's files are linked unmodified
 * from public/clarity/ exactly as clarity.html links them; src/styles/global.css
 * adds only the site layer (nav, simulations, rounded covers, dark mode).
 */
import 'katex/dist/katex.min.css';
import 'img-comparison-slider/dist/styles.css';
import '../styles/global.css';
import { PROFILE, NAV } from '../data/site';
import Icon from '../components/clarity/Icon.astro';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: unknown[];
  /** Load Clarity's hoverable table of contents (navbar.js), built from the h1/h2 of main containers. */
  toc?: boolean;
  /** Breadcrumb trail for structured data, e.g. [{name: 'Research', path: '/research'}, …]. */
  breadcrumbs?: { name: string; path: string }[];
  /** Google Scholar / Highwire citation tags for a paper page. */
  citation?: {
    title: string;
    authors: string[];
    date: string;
    arxivId?: string;
    pdfUrl?: string;
    abstractUrl?: string;
    publisher?: string;
  };
  /** Keep a page out of search results (404). */
  noindex?: boolean;
}

const { title, description, ogType = 'website', ogImage, ogImageAlt, jsonLd, toc = false, breadcrumbs, citation, noindex = false } = Astro.props;

/** Under build.format 'file' Astro reports /research.html; strip it once. */
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const section = path === '/' ? '/' : '/' + path.split('/')[1];

const SITE = Astro.site!;
const personId = new URL('/#person', SITE).href;
const websiteId = new URL('/#website', SITE).href;
const ogImg = new URL(ogImage ?? '/og.png', SITE).href;

/** One JSON-LD graph per page: the person, the site, this page, and its trail. */
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: PROFILE.name,
    alternateName: [PROFILE.fullName, 'A. S. Valse', 'A. Valse'],
    givenName: 'Akshat',
    familyName: 'Valse',
    url: SITE.href,
    image: new URL(PROFILE.portrait.src, SITE).href,
    email: `mailto:${PROFILE.email}`,
    jobTitle: 'Undergraduate Researcher',
    description:
      'Undergraduate researcher at Iowa State University in applied probability for the systems ' +
      'that run machine learning: LLM serving and prefix caching, Langevin sampling, large ' +
      'deviations and rare events, stability of learned PDE solvers, online calibration, and the ' +
      'reliability of tool-using agents. Author, with Ali Jannesari, of "Inside the Trap: A Renewal ' +
      'Law for Prefix-Cache Collapse in LLM Agent Serving" (arXiv:2611.08902).',
    sameAs: [PROFILE.github, PROFILE.linkedin],
    affiliation: { '@type': 'CollegeOrUniversity', name: 'Iowa State University', url: 'https://www.iastate.edu/' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Iowa State University', url: 'https://www.iastate.edu/' },
    knowsAbout: [
      'Applied probability', 'Machine learning systems', 'LLM serving', 'Prefix caching', 'KV cache',
      'Queueing theory', 'Renewal theory', 'Langevin dynamics', 'Markov chain Monte Carlo',
      'Diffusion models', 'Large deviations', 'Importance sampling', 'Numerical analysis',
      'Neural PDE solvers', 'Conformal prediction', 'LLM agents',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: SITE.href,
    name: PROFILE.name,
    alternateName: PROFILE.fullName,
    description: `${PROFILE.name}: ${PROFILE.tagline.toLowerCase()}. Research, publications and CV.`,
    publisher: { '@id': personId },
    inLanguage: 'en',
  },
  {
    '@type': path === '/' ? 'ProfilePage' : 'WebPage',
    '@id': canonical.href,
    url: canonical.href,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    ...(path === '/' ? { mainEntity: { '@id': personId } } : { author: { '@id': personId } }),
    primaryImageOfPage: ogImg,
    inLanguage: 'en',
  },
];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.path, SITE).href,
    })),
  });
}
const ld = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#E0E4E6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#304463" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? `${PROFILE.fullName}: ${PROFILE.tagline}.`} />
    {ogType === 'profile' && <><meta property="profile:first_name" content="Akshat" /><meta property="profile:last_name" content="Valse" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="author" content={PROFILE.fullName} />
    {citation && (
      <>
        <meta name="citation_title" content={citation.title} />
        {citation.authors.map((a) => <meta name="citation_author" content={a} />)}
        <meta name="citation_publication_date" content={citation.date} />
        <meta name="citation_online_date" content={citation.date} />
        {citation.publisher && <meta name="citation_publisher" content={citation.publisher} />}
        {citation.arxivId && <meta name="citation_arxiv_id" content={citation.arxivId} />}
        {citation.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}
        {citation.abstractUrl && <meta name="citation_abstract_html_url" content={citation.abstractUrl} />}
      </>
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="me" href={PROFILE.github} />
    <link rel="me" href={PROFILE.linkedin} />

    <!-- Fonts that Clarity's stylesheet imports: connect early -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preload" href="/clarity/assets/fonts/Charter/charter_regular.woff2" as="font" type="font/woff2" crossorigin />

    <!-- The Clarity template, unmodified -->
    <link rel="stylesheet" type="text/css" media="all" href="/clarity/assets/stylesheets/main_free.css" />
    <link rel="stylesheet" type="text/css" media="all" href="/clarity/clarity/clarity.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/styles/foundation.min.css" />
    <link rel="stylesheet" href="/clarity/assets/fontawesome-free-7.2.0-web/css/all.min.css" />
    {toc && <script is:inline src="/clarity/assets/scripts/navbar.js"></script>}

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {jsonLd?.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>

  <body>
    <a class="skip-link" href="#first-content">Skip to content</a>

    <!-- Navigation, as on shikun.io (the site that hosts Clarity) -->
    <div class="site-nav">
      <div class="container">
        <div class="site-nav-inner">
          <nav class="menu" aria-label="Primary">
            {NAV.map((item) => (
              <a href={item.href} aria-current={section === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
          <div class="social">
            <a href={PROFILE.github} rel="me" aria-label="GitHub"><Icon name="github" /></a>
            <a href={PROFILE.linkedin} rel="me" aria-label="LinkedIn"><Icon name="linkedin" /></a>
            <a href={`mailto:${PROFILE.email}`} aria-label="Email"><Icon name="mail" /></a>
            <a href={PROFILE.cvPdf} aria-label="CV (PDF)"><Icon name="cv" /></a>
          </div>
        </div>
      </div>
    </div>

    <slot />

    <!-- Footer Page -->
    <footer>
      <div class="container">
        <p>
          {PROFILE.fullName} · {PROFILE.tagline} · Iowa State University ·
          <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        </p>
        <p>
          This website is built on the <a href="https://shikun.io/projects/clarity">Clarity Template</a>,
          designed by <a href="https://shikun.io/">Shikun Liu</a>. Every figure is a live simulation
          checked against an exact reference (<a href="https://github.com/AkshatValse/akshatvalse-site">source and checks</a>).
        </p>
      </div>
    </footer>

    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/highlight.min.js"></script>
    <script is:inline src="/clarity/hljs-init.js"></script>
    <script is:inline src="/clarity/assets/scripts/main.js"></script>
    <script>
      import 'img-comparison-slider';
    </script>
  </body>
</html>
