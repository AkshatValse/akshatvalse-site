---
import { Font } from 'astro:assets';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  /** Absolute path to a per-page social card; falls back to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Extra JSON-LD blocks emitted alongside the Person graph. */
  jsonLd?: unknown[];
}

const { title, description, ogType = 'website', ogImage, ogImageAlt, jsonLd } = Astro.props;

/**
 * Under `build.format: 'file'` Astro serves clean URLs but reports
 * `Astro.url.pathname` as `/research.html`. Left alone that produces a
 * canonical pointing at a URL the host immediately 308s away, and a nav whose
 * aria-current never matches. Strip the extension once, use it for both.
 */
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);

const NAV = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/notes', label: 'Notes' },
  { href: '/cv', label: 'CV' },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Akshat Sachin Valse',
  // People search the full legal name; the site uses the short one everywhere else.
  alternateName: ['Akshat Valse', 'A. S. Valse'],
  url: Astro.site?.href,
  email: 'mailto:avalse@iastate.edu',
  jobTitle: 'Undergraduate researcher',
  description:
    'Undergraduate researcher at Iowa State University working on the stochastic ' +
    'foundations of machine learning: Langevin sampling and its discretization bias, ' +
    'large deviations for mean-field interacting systems, and the stability of learned ' +
    'PDE solvers.',
  // sameAs is what lets a search engine decide these accounts are one person.
  sameAs: [
    'https://github.com/AkshatValse',
    'https://linkedin.com/in/akshat-sachin-valse',
  ],
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Iowa State University' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Iowa State University' },
  knowsAbout: [
    'Stochastic differential equations',
    'Diffusion models and score-based generative modeling',
    'Langevin dynamics and Markov chain Monte Carlo',
    'Large deviations and mean-field interacting particle systems',
    'Machine learning theory',
    'Numerical analysis of learned PDE solvers',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(ogImage ?? '/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={ogImageAlt ??
        'Akshat Sachin Valse — stochastic foundations of machine learning, Iowa State University. Above the name, a field of particles undergoing Langevin dynamics collected into the wells of a periodic potential.'}
    />
    <meta property="og:site_name" content="Akshat Sachin Valse" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage ?? '/og.png', Astro.site).href} />
    <meta name="author" content="Akshat Sachin Valse" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Notes — Akshat Sachin Valse"
      href={new URL('/rss.xml', Astro.site).href}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body-italic" />
    <Font cssVariable="--font-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {jsonLd?.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead shell">
      <div class="row">
        <div class="rail" aria-hidden="true"></div>
        <div>
          <p class="name">
            {path === '/' ? 'Akshat Valse' : <a href="/">Akshat Valse</a>}
          </p>
          <p class="tagline">Stochastic foundations of machine learning &middot; Iowa State University</p>
          <nav class="nav" aria-label="Primary">
            {NAV.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <slot name="hero" />

    <main id="main">
      <slot />
    </main>

    <footer class="footer shell">
      <div class="row">
        <div class="rail"><span class="rail-label">contact</span></div>
        <div>
          <p>
            <span class="fullname">Akshat Sachin Valse</span>,
            Department of Mathematics, Iowa State University.
          </p>
          <p class="availability">
            PhD applications: Fall 2027 cycle &middot; B.S. expected May 2028.
          </p>
          <p>
            <a href="mailto:avalse@iastate.edu">avalse@iastate.edu</a>
            &middot;
            <a href="https://github.com/AkshatValse" rel="me">github.com/AkshatValse</a>
          </p>
          <p>
            Outside of research I fly (private pilot, high-performance endorsement) and
            volunteer with <a href="https://www.pilotsnpaws.org/">Pilots N Paws</a>.
          </p>
          <p class="colophon">
            Set in Archivo, Source Serif&nbsp;4 and IBM Plex Mono; mathematics in KaTeX.
            Every figure is a live simulation, each checked against a closed form.
            <a href="https://github.com/AkshatValse/akshatvalse-site">Source and checks</a>
            live in <code>src/sim</code> and <code>scripts/verify-*</code>; the
            tolerances run on every push
            (<a href="https://github.com/AkshatValse/akshatvalse-site/actions/workflows/verify.yml">checks</a>).
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
