---
/**
 * One research project per page, as a Clarity blog post:
 *   title page (#first-content on the project's signature colour, as shikun.io's
 *   project pages: title, authors, affiliation, abstract, link
 *   buttons, venue line, cover), then the page's own Clarity containers, then
 *   previous / next. Clarity's navbar.js builds the floating table of
 *   contents from the h1/h2 headings inside `container blog main` divs.
 */
import Base from './Base.astro';
import TitleBand from '../components/clarity/TitleBand.astro';
import Container from '../components/clarity/Container.astro';
import Icon, { type IconName } from '../components/clarity/Icon.astro';
import { bySlug, neighbours } from '../data/projects';

interface LinkButton { label: string; href: string; icon: IconName }

interface Props {
  slug: string;
  pageTitle?: string;
  description: string;
  title?: string;
  /** Author line, e.g. "Akshat Valse and Ali Jannesari". */
  authors: string;
  /** Affiliation line under the authors. */
  affiliation: string;
  abstract: string;
  buttons?: LinkButton[];
  /** Venue / status line at the foot of the intro, e.g. "arXiv preprint · November 2026". */
  info: string;
  ogType?: string;
  jsonLd?: unknown[];
  /** Google Scholar citation tags (paper pages). */
  citation?: { title: string; authors: string[]; date: string; arxivId?: string; pdfUrl?: string; abstractUrl?: string; publisher?: string };
}

const { slug, pageTitle, description, title, authors, affiliation, abstract, buttons = [], info, ogType = 'article', jsonLd, citation } = Astro.props;
const p = bySlug(slug);
const { prev, next } = neighbours(slug);
---

<Base
  title={pageTitle ?? `${p.short} · Akshat Valse`}
  description={description}
  ogType={ogType}
  ogImage={`/og/${p.slug}.png`}
  ogImageAlt={`${p.short}: ${p.subtitle}. ${p.badge}, by Akshat Valse. The project's cover artwork in its themed frame.`}
  jsonLd={jsonLd}
  citation={citation}
  breadcrumbs={[{ name: 'Research', path: '/research' }, { name: p.short, path: `/research/${p.slug}` }]}
  toc
  navOnDark={p.ink === 'light'}
>
  <TitleBand
    bandStyle={p.band}
    white={p.ink === 'light'}
    cover={{ src: p.art, alt: p.artAlt, width: 1200, height: 1600 }}
  >
    <h1 class="title">{title ?? p.title}</h1>
    <p class="author">{authors}</p>
    <p class="author" style="padding-top: 0px;">{affiliation}</p>
    <p class="abstract">{abstract}</p>
    {buttons.length > 0 && (
      <div class="info">
        <div>
          {buttons.map((b) => (
            <><a href={b.href} class="button icon" style={`background-color: ${p.button}`}>{b.label} <Icon name={b.icon} /></a>&nbsp;&nbsp; </>
          ))}
        </div>
      </div>
    )}
    <Fragment slot="info">{info}</Fragment>
  </TitleBand>

  <slot />

  <Container>
    <hr />
    <p class="text">
      {prev && <a href={`/research/${prev.slug}`} class="button icon"><Icon name="arrow-left" /> {prev.short}</a>}
      &nbsp;&nbsp;
      <a href="/research" class="button">All research</a>
      &nbsp;&nbsp;
      {next && <a href={`/research/${next.slug}`} class="button icon">{next.short} <Icon name="arrow" /></a>}
    </p>
  </Container>
</Base>
