---
/**
 * Stability of neural approximations to evolution equations (with Jue Yan and
 * Mengyuan Yang). Unpublished joint work. The owner's rule: "Keep the
 * unpublished work descriptive about what we are doing but do not give away
 * any results or anything that will result in a scoop risk." So this page
 * gives the problem and the setting (as the public write-up does,
 * github.com/AkshatValse/research, cann-stability.md), a textbook von Neumann
 * definition labelled as such, and what we are doing at the level of the CV
 * research entry and the CV's manuscript title, no further. No results, no
 * theorem statements, no form of the stability condition or certificate, no
 * stencil, architecture, activation, PDE or experiment details. Facts are from
 * the verified brief gh/briefs/neural-pde-stability.md and src/pages/cv.astro.
 */
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Container from '../../components/clarity/Container.astro';
import NoteRow from '../../components/clarity/NoteRow.astro';
import Icon from '../../components/clarity/Icon.astro';
import Tex from '../../components/Tex.astro';
import PdeConservation from '../../components/widgets/PdeConservation.astro';

const WRITEUP = 'https://github.com/AkshatValse/research/blob/main/cann-stability.md';

/**
 * Figure 2 (brief diagrams D1 and D3): three cells and the flux at the two
 * faces of cell j, learned beside a textbook designed flux. Drawn inline rather
 * than loading public/research/neural-pde-stability/stencil*.svg through <img>,
 * so it follows the page tokens in dark mode (the files' monospace footer also
 * overflows their viewBox when rendered as images). No stencil width for
 * V_{j+1/2} is drawn: it is not public.
 */
const F2 = {
  base: 226,
  cells: [
    { x: 45, cx: 110, top: 164, sub: 'j−1' },
    { x: 175, cx: 240, top: 140, sub: 'j' },
    { x: 305, cx: 370, top: 180, sub: 'j+1' },
  ],
  faces: [
    { x: 45, sub: 'j−3/2', inner: false, left: '' },
    { x: 175, sub: 'j−1/2', inner: true, left: 'j−1' },
    { x: 305, sub: 'j+1/2', inner: true, left: 'j' },
    { x: 435, sub: 'j+3/2', inner: false, left: '' },
  ],
  panels: [
    {
      key: 'learned', title: 'Learned flux', marker: 'npde-f2a-arrow',
      label: 'Schematic of three finite-volume cells j-1, j and j+1 with illustrative cell averages drawn as bars. At the two faces of cell j the same network N(V; Theta), with the same weights, is evaluated. An arrow across each face marks the face value as subtracted from the cell on its left and added to the cell on its right.',
    },
    {
      key: 'designed', title: 'Designed flux (textbook, for comparison)', marker: 'npde-f2b-arrow',
      label: 'The same three cells with a textbook designed flux for comparison: first-order upwind for u_t + a u_x = 0 with a > 0, whose face values are a times the cell average upwind of each face. Each face value is subtracted from the cell on its left and added to the cell on its right.',
    },
  ],
};

/** Equation (1): the learned conservative update, as on the live research page. */
const EQ1 = String.raw`\bar v_j^{\,n+1} = \bar v_j^{\,n} - \tfrac{\Delta t}{\Delta x}\big[\mathcal{N}(V_{j+1/2};\Theta) - \mathcal{N}(V_{j-1/2};\Theta)\big], \tag{1}`;
/** Equation (2): (1) summed over the cells. */
const EQ2 = String.raw`\sum_{j=1}^{M} \bar v_j^{\,n+1} = \sum_{j=1}^{M} \bar v_j^{\,n} - \tfrac{\Delta t}{\Delta x}\big[\mathcal N(V_{M+1/2};\Theta) - \mathcal N(V_{1/2};\Theta)\big]. \tag{2}`;
/**
 * Equation (3): textbook only. First-order upwind for u_t + a u_x = 0, a > 0,
 * the designed flux of Figure 2, with nu = a dt/dx. Derivation:
 * |(1-nu) + nu e^{-i theta}|^2 = 1 - 2 nu (1-nu)(1 - cos theta), so |G| <= 1
 * for every theta iff 0 <= nu <= 1. Not the project's scheme or result.
 */
const EQ3 = String.raw`G(\theta) = 1 - \nu\big(1 - e^{-\mathrm{i}\theta}\big), \qquad |G(\theta)|^2 = 1 - 2\nu(1-\nu)(1-\cos\theta). \tag{3}`;

/** Figure 3 geometry: a periodic row of five cells, bar heights illustrative. */
const F3 = (() => {
  const x0 = 105, w = 150, base = 250;
  const heights = [70, 120, 150, 92, 64];
  const faces = Array.from({ length: heights.length + 1 }, (_, k) => ({ x: x0 + w * k, sub: `${2 * k + 1}/2` }));
  const cells = heights.map((h, j) => ({ x: x0 + w * j, cx: x0 + w * (j + 0.5), top: base - h, j: j + 1 }));
  return { w, base, faces, cells, first: faces[0], last: faces[faces.length - 1] };
})();
