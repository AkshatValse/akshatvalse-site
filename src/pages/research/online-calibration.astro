/**
 * Online calibration with early, one-sided feedback (Hongyang Gao, Computer
 * Science). The paper is in preparation, so this page describes the problem
 * and what we are doing at the CV's level of detail: the observation
 * structure, formalized, two schematics and a classical toy with an exact
 * reference. The method's construction, the theory and every result stay
 * private. Sources: the CV research entry, the public overview README
 * (AkshatValse/neural-forecasting-research-overview) and the site's own text.
 */
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Container from '../../components/clarity/Container.astro';
import Icon from '../../components/clarity/Icon.astro';
import Tex from '../../components/Tex.astro';
import CalibEarlyMiss from '../../components/widgets/CalibEarlyMiss.astro';

const OVERVIEW = 'https://github.com/AkshatValse/neural-forecasting-research-overview';
const ASSETS = '/research/online-calibration';

const ABSTRACT =
  'Risk forecasts for a cumulative quantity, such as the realized variance of an asset over the next six or ' +
  'twenty-four hours, are usually scored when the horizon ends, so a calibrator that waits for the complete ' +
  'outcome receives feedback one full horizon later. Yet the increments of such a target are non-negative: once ' +
  'the running sum crosses the issued upper bound, the miss is certain, while coverage is only confirmed at the ' +
  'end. We are developing a model-agnostic calibration method for quantile forecasts that uses this early, ' +
  'one-sided feedback, with theory and experiments in progress. The paper is in preparation; code, proofs ' +
  'and results are held back pending submission.';

/** χ² toy, α = 0.1: exact closed-form values (toy values, not project results). */
const REFERENCE = [
  { H: 12, u: '18.549347787', c: 1, miss: '0.100000', early: '0.696783', lead: '1.8129' },
  { H: 12, u: '18.549347787', c: 2, miss: '0.679308', early: '0.878181', lead: '3.5596' },
  { H: 72, u: '87.743047749', c: 1, miss: '0.100000', early: '0.864984', lead: '5.2231' },
  { H: 72, u: '87.743047749', c: 2, miss: '0.996409', early: '0.998892', lead: '26.7387' },
  { H: 288, u: '319.153638462', c: 1, miss: '0.100000', early: '0.929895', lead: '10.9193' },
  { H: 288, u: '319.153638462', c: 2, miss: '1.000000', early: '1.000000', lead: '126.9232' },
];

