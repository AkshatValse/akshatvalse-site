      <circle class="oc-acc" cx="397.3" cy="174.6" r="6.5" />
      <text x="389" y="66" text-anchor="end" font-size="13" font-weight="500">miss certain here</text>
      <text class="muted-t" x="407" y="66" font-size="12.5">known for the rest</text>
      <text class="muted-t" x="407" y="82" font-size="12.5">of the horizon</text>

