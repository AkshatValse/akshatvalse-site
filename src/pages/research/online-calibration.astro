   (H = 24; covered path Z² increments, seed 5005; missing path 2Z² increments, seed 1008;
   bound at the upper 0.1 quantile of χ²₂₄), rescaled. First crossing at the vertex k = τ = 16. */
const D1_MISS_SOLID = '72.0,330.0 92.3,322.6 112.7,317.4 133.0,317.4 153.3,304.8 173.7,296.0 194.0,247.6 214.3,238.0 234.7,236.9 255.0,230.2 275.3,229.4 295.7,226.9 316.0,215.4 336.3,214.9 356.7,213.8 377.0,203.4 397.3,174.6';
const D1_MISS_AFTER = '397.3,174.6 417.7,162.5 438.0,130.2 458.3,130.1 478.7,128.7 499.0,126.7 519.3,126.5 539.7,108.2 560.0,92.8';
const D1_COVERED = '72.0,330.0 92.3,304.3 112.7,302.5 133.0,301.8 153.3,300.3 173.7,300.3 194.0,293.6 214.3,290.0 234.7,289.8 255.0,285.6 275.3,272.0 295.7,251.7 316.0,250.8 336.3,249.5 356.7,242.1 377.0,242.0 397.3,240.6 417.7,239.5 438.0,238.8 458.3,229.9 478.7,229.9 499.0,229.9 519.3,227.4 539.7,206.0 560.0,203.7';
