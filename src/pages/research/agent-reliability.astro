 *
 * Sources for every project fact: the public site (research.astro, CV) and the
 * GitHub profile README, as collected in the verified brief. Everything beyond
 * the public problem statement is a CLASSICAL BASELINE (a known run-time law,
 * independent restarts; crude Monte Carlo arithmetic), computed and checked for
 * this page, labelled as such wherever it appears, and never project data.
 *
 * Static charts are inlined (?raw) so their var(--token) colours resolve and
 * dark mode works; they are not wrapped in .diagram, whose rules would restyle
 * them. Hand-drawn diagrams use the site's .diagram classes and tokens only.
 *
 * Scoop rule: the page says what the project asks and plans (CV level) and
 * nothing that points at a method or links the rare-failure question to any
 * other project's figure. The rare-failure diagram's footer is rewritten below
 * to "problem only", and the build fails if the old footer survives.
 */
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Container from '../../components/clarity/Container.astro';
import NoteRow from '../../components/clarity/NoteRow.astro';
import Slides from '../../components/clarity/Slides.astro';
import CodeBlock from '../../components/clarity/CodeBlock.astro';
import Tex from '../../components/Tex.astro';
import AgentRestartWidget from '../../components/widgets/AgentRestartWidget.astro';
import AgentRareCount from '../../components/widgets/AgentRareCount.astro';
import ruleSvg from '../../../public/research/agent-reliability/restart-rule.svg?raw';
import lnC0Svg from '../../../public/research/agent-reliability/restart-lognormal-c0.svg?raw';
import lnC05Svg from '../../../public/research/agent-reliability/restart-lognormal-c0.5.svg?raw';
import mixSvg from '../../../public/research/agent-reliability/restart-mixture.svg?raw';
import hangSvg from '../../../public/research/agent-reliability/restart-hang.svg?raw';
import rareSvgRaw from '../../../public/research/agent-reliability/diagram-rare-failure.svg?raw';

/** The asset's two-line footer pointed to another project's figure; keep only "problem only". */
const RARE_FOOTER = "The problem only; this project's approach is held back.";
const rareSvg = rareSvgRaw.replace(
  /<text class="ts" x="30" y="336">[^<]*<\/text>\s*<text class="ts" x="30" y="350">[^<]*<\/text>/,
  `<text class="ts" x="30" y="343">${RARE_FOOTER}</text>`,
);
if (!rareSvg.includes(RARE_FOOTER) || /rare-event figure|Gaussian tail/i.test(rareSvg)) {
  throw new Error('agent-reliability: rare-failure diagram footer was not replaced with the problem-only line.');
}

/**
 * Density of ln T for a lognormal with median 1 and spread sigma (a normal
 * curve on a log-time axis), scaled into a box, for the hand-drawn diagrams.
 * Drawn for sigma = 1.5 and age tau = 2, the brief's diagram case.
 */
const SIGMA = 1.5;
const LN_TAU = Math.log(2);
function bell(x0: number, x1: number, base: number, height: number, u0 = -4.5, u1 = 4.5) {
  const xOf = (u: number) => x0 + ((u - u0) / (u1 - u0)) * (x1 - x0);
  const yOf = (u: number) => base - height * Math.exp(-(u * u) / (2 * SIGMA * SIGMA));
  const pts = (a: number, b: number, n: number) =>
    Array.from({ length: n + 1 }, (_, i) => a + ((b - a) * i) / n).map((u) => `${xOf(u).toFixed(1)} ${yOf(u).toFixed(1)}`);
  const curve = `M${pts(u0, u1, 120).join('L')}`;
  const tail = `M${xOf(LN_TAU).toFixed(1)} ${base}L${pts(LN_TAU, u1, 70).join('L')}L${xOf(u1).toFixed(1)} ${base}Z`;
  return { xOf, curve, tail, tauX: xOf(LN_TAU) };
}
const d1 = bell(40, 390, 262, 160);
const d1Ticks = [0.1, 1, 10].map((t) => ({ t, x: d1.xOf(Math.log(t)) }));
const cov = bell(36, 444, 168, 116);

/** The lognormal baseline in a few lines (the widget's AgentRestartMath.ts, with mu = 0). */
const CODE = `// Lognormal run time with median 1: T = exp(sigma * Z).
// upper(x) = P(Z > x) and lower(x) = P(Z <= x), each on its accurate tail.
function restartTime(tau, sigma, c) {
  const z = Math.log(tau) / sigma;
  const F = lower(z), S = upper(z);
  const A = Math.exp(sigma * sigma / 2) * lower(z - sigma) + tau * S;  // E[min(T, tau)]
  return (A + c * S) / F;                                              // E[T_{tau,c}]
}

function meanResidual(tau, sigma) {                                   // m(tau)
  const z = Math.log(tau) / sigma;
  return (Math.exp(sigma * sigma / 2) * upper(z - sigma) - tau * upper(z)) / upper(z);
}`;

/** Classical baseline, lognormal with median 1: brief "Tables" (log lines 350-470). */
const ROWS = [
  { s: '0.5', et: '1.133', c: '0', star: 'no measurable gain', ratio: '1.0000000 (gain 3.3 × 10⁻⁸)' },
  { s: '1.0', et: '1.649', c: '0', star: '1.73', ratio: '0.892' },
  { s: '1.0', et: '1.649', c: '0.5', star: '3.68', ratio: '0.955' },
  { s: '1.5', et: '3.080', c: '0', star: '0.349', ratio: '0.413' },
  { s: '1.5', et: '3.080', c: '0.5', star: '1.56', ratio: '0.601' },
  { s: '2.0', et: '7.389', c: '0', star: '0.0512', ratio: '0.0976' },
  { s: '2.0', et: '7.389', c: '0.5', star: '0.886', ratio: '0.248' },
  { s: '2.5', et: '22.76', c: '0', star: '0.00502', ratio: '0.0128' },
  { s: '2.5', et: '22.76', c: '0.5', star: '0.592', ratio: '0.0752' },
];
