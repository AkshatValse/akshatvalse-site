/* ---------- Figure 7 (two failure modes): curves drawn from the exact formulas ---------- */

const f1 = (v: number) => v.toFixed(1);
function trace(n: number, a: number, b: number, f: (x: number) => number, X: (x: number) => number, Y: (y: number) => number): string {
  const out: string[] = [];
  for (let i = 0; i <= n; i++) {
    const x = a + ((b - a) * i) / n;
    out.push(`${i ? 'L' : 'M'}${f1(X(x))} ${f1(Y(f(x)))}`);
  }
  return out.join(' ');
}
const gauss = (x: number, v: number) => Math.exp(-(x * x) / (2 * v)) / Math.sqrt(2 * Math.PI * v);

// Left panel: target N(0, 1) and ULA's pi_h = N(0, v(h)) at s = 1, h = 0.4, v(h) = 1.25.
const BX = (x: number) => 290 + 55 * x;
const BY = (d: number) => 300 - 450 * d;
const biasTarget = trace(200, -4, 4, (x) => gauss(x, 1), BX, BY);
const biasPih = trace(200, -4, 4, (x) => gauss(x, 1.25), BX, BY);
const biasPihFill = `${biasPih} L${f1(BX(4))} ${f1(BY(0))} L${f1(BX(-4))} ${f1(BY(0))} Z`;

// Right panel: U(x) = -log pi(x, 0) for the two-component mixture at mu = 3, s = 1
// (log-sum-exp of the two components, as in LS/src/langevin/targets.py), shifted to min 0.
const MU = 3;
const U = (x: number) => {
  const a = -((x + MU) ** 2) / 2;
  const b = -((x - MU) ** 2) / 2;
  const m = Math.max(a, b);
  return -(m + Math.log(0.5 * Math.exp(a - m) + 0.5 * Math.exp(b - m)));
};
let uMin = Infinity;
let xMin = MU;
for (let i = 0; i <= 6000; i++) {
  const x = (6 * i) / 6000;
  const u = U(x);
  if (u < uMin) { uMin = u; xMin = x; }
}
const MX = (x: number) => 840 + (460 / 12) * x;
const MY = (u: number) => 300 - 36 * u;
const mixCurve = trace(300, -6, 6, (x) => U(x) - uMin, MX, MY);
const saddleY = MY(U(0) - uMin);
const wellL = MX(-xMin);
const wellR = MX(xMin);
