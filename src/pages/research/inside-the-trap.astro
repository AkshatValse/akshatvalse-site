/**
 * Minimal sub/superscript markup for SVG <text>: a_b, a_{bc}, a^b, a^{bc}
 * become tspans with a baseline shift; everything else is escaped text.
 */
function tx(s: string): string {
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  let out = '', off = 0, buf = '';
  const flush = () => {
    if (!buf) return;
    out += off !== 0 ? `<tspan dy="${-off}">${esc(buf)}</tspan>` : esc(buf);
    off = 0; buf = '';
  };
  for (let i = 0; i < s.length; ) {
    const ch = s[i];
    if ((ch === '_' || ch === '^') && i + 1 < s.length) {
      flush();
      let body: string;
      if (s[i + 1] === '{') { const j = s.indexOf('}', i + 2); body = s.slice(i + 2, j); i = j + 1; }
      else { body = s[i + 1]; i += 2; }
      const target = ch === '_' ? 4 : -6;
      out += `<tspan dy="${target - off}" font-size="0.72em">${esc(body)}</tspan>`;
      off = target;
    } else { buf += ch; i++; }
  }
  flush();
  return out;
}

/* D1: hit and miss prefill bars, to scale (551 against about 11,100 tokens). */
const MISS_W = 760;
const HIT_W = (551 / 11100) * MISS_W;

/* D3: the tilted turn mix for the standard workload at 1.65 lambda_ref, from the site's model F. */
const tc = costs();
const F165 = trapLimits(1.65 * LAMBDA_REF, tc);
const zz: number = F165.z;
const tilt = tc.G.map((g: number, i: number) => g * Math.pow(zz, -(i + 1)));
const tiltSum = tilt.reduce((a: number, b: number) => a + b, 0);
const nuZ = tilt.map((v: number) => v / tiltSum);
const nuS = tc.G.map((g: number) => g / tc.ET);
const BX0 = 540, BX1 = 965, BY0 = 286, BY1 = 372;
const bw = (BX1 - BX0) / nuZ.length;
const bTop = Math.max(nuZ[0], nuS[0]) * 1.05;
const by = (v: number) => BY1 - (v / bTop) * (BY1 - BY0);
const d3Bars = nuZ.map((v: number, i: number) => ({ x: BX0 + i * bw + 0.5, y: by(v), w: bw - 1, h: BY1 - by(v) }));
const d3Stat = nuS.map((v: number, i: number) => `${i ? 'L' : 'M'}${(BX0 + i * bw).toFixed(1)},${by(v).toFixed(1)}H${(BX0 + (i + 1) * bw).toFixed(1)}`).join('');

/*
 * Compare twin: one session's gap against the pool turnover time, on a common
 * log axis (1 s to 1000 s). Drawn with the site's tokens on white, like the
 * paper's figures.
 */
const lx = (t: number) => 60 + (Math.log10(t) / 3) * 540;
function twin(kind: 'good' | 'trap'): string {
  const d = kind === 'good'
    ? { gap: [4.9, 5.9], rm: [188, 505], ratio: '0.010–0.028', gapLab: '4.9–5.9 s', rmLab: '188–505 s' }
    : { gap: [166, 516], rm: [26, 78], ratio: '4.1–9.7', gapLab: '166–516 s', rmLab: '26–78 s' };
  const bar = (r: number[], y: number, fill: string, lab: string) => {
    const x0 = lx(r[0]), x1 = lx(r[1]);
    const label = x1 < 420
      ? `<text x="${(x1 + 10).toFixed(1)}" y="${y + 20}" font-size="18" font-weight="700" fill="#353535">${lab}</text>`
      : `<text x="${(x0 - 10).toFixed(1)}" y="${y + 20}" font-size="18" font-weight="700" fill="#353535" text-anchor="end">${lab}</text>`;
    return `<rect x="${x0.toFixed(1)}" y="${y}" width="${(x1 - x0).toFixed(1)}" height="28" rx="3" fill="${fill}"/>${label}`;
  };
  let axis = '';
  for (let e = 0; e <= 3; e++) {
    const x = lx(10 ** e).toFixed(1);
    axis += `<line x1="${x}" y1="44" x2="${x}" y2="270" stroke="#e3e3e3" stroke-width="1"/>`;
    axis += `<line x1="${x}" y1="270" x2="${x}" y2="280" stroke="#666667" stroke-width="1.4"/>`;
    axis += `<text x="${x}" y="300" font-size="15" fill="#666667" text-anchor="middle">${10 ** e} s</text>`;
    if (e < 3) for (let m = 2; m <= 9; m++) {
      const xm = lx(m * 10 ** e).toFixed(1);
      axis += `<line x1="${xm}" y1="270" x2="${xm}" y2="276" stroke="#9f9fa0" stroke-width="1"/>`;
    }
  }
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 480" width="640" height="480" font-family="Helvetica, Arial, sans-serif">` +
    `<rect width="640" height="480" fill="#ffffff"/>` + axis +
    `<line x1="60" y1="270" x2="600" y2="270" stroke="#666667" stroke-width="1.4"/>` +
    `<text x="40" y="34" font-size="17" fill="#353535">Gap between a session's consecutive turns</text>` +
    bar(d.gap, 70, '#00224e', d.gapLab) +
    `<text x="40" y="150" font-size="17" fill="#353535">Pool turnover time R<tspan dy="5" font-size="12">M</tspan><tspan dy="-5"> = M/churn</tspan></text>` +
    bar(d.rm, 170, '#767678', d.rmLab) +
    `<text x="330" y="326" font-size="15" fill="#666667" text-anchor="middle">time, log scale</text>` +
    `<text x="40" y="378" font-size="24" font-weight="700" fill="#353535">gap / R<tspan dy="6" font-size="16">M</tspan><tspan dy="-6"> = ${d.ratio}</tspan></text>` +
    `<text x="40" y="408" font-size="14" fill="#666667">ranges over the arms of the first three registered tests</text>` +
    `</svg>`;
  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
}
const TWIN_GOOD = twin('good');
const TWIN_TRAP = twin('trap');
