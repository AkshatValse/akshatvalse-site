---
import Base from '../layouts/Base.astro';
import TitleBand from '../components/clarity/TitleBand.astro';
import Container from '../components/clarity/Container.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../data/projects';
---

<Base
  title="Research · Akshat Valse"
  breadcrumbs={[{ name: 'Research', path: '/research' }]}
  description="Six research projects in applied probability for the systems that run machine learning: prefix-cache collapse in LLM agent serving, Langevin sampling, large deviations and rare events, stability of learned PDE solvers, early-feedback calibration, and the reliability of tool-using agents."
>
  <TitleBand>
    <h1 class="title">Research</h1>
    <p class="author">Six projects, six advisors, one habit</p>
    <p class="abstract">
      The first is the paper this site is built around: <a href="/research/inside-the-trap"><em>Inside the
      Trap</em></a>, a renewal law for prefix-cache collapse in LLM agent serving, tested in registered
      experiments on real engines. The other five are where its methods come from and where they go
      next. All six keep one habit: a closed form where one exists, a registered prediction where one
      does not, and a check that runs either way.
    </p>
    <Fragment slot="info">1 preprint · 4 manuscripts in preparation</Fragment>
  </TitleBand>

  <Container width="extra-large" tone="gray" first>
    <div class="columns-3">
      {PROJECTS.map((p) => <ProjectCard project={p} />)}
    </div>
  </Container>

  <Container>
    <h1>At a glance</h1>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>Project</th><th>Advisor</th><th>Department</th><th>Since</th><th>Status</th></tr></thead>
        <tbody>
          {PROJECTS.map((p) => (
            <tr>
              <td><a href={`/research/${p.slug}`}>{p.short}</a></td>
              <td>{p.advisor}</td>
              <td>{p.dept}</td>
              <td>{p.dates.replace(' – present', '')}</td>
              <td>{p.status === 'Preprint' ? <b>Preprint</b> : 'Ongoing'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Container>
</Base>
