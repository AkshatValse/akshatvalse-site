---
/**
 * Home: a greeting, who I am, one italic line on the research focus, the
 * flying, and a "Read more" button on the left; the portrait on the right.
 * The layout follows shikun.io's home; the words are mine. Everything else
 * lives on /research and /about.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/clarity/Icon.astro';
import { PROFILE } from '../data/site';

const { portrait } = PROFILE;
---

<Base
  title="Akshat Valse · Applied probability for ML systems · Iowa State"
  ogType="profile"
  description="Akshat Valse, Iowa State undergraduate researcher in applied probability for ML systems: LLM serving and KV caching, Langevin sampling, rare events."
>
  <div class="container page" id="first-content">
    <div class="home">
      <div class="home-intro">
        <h1 class="title">Hi, I'm Akshat.</h1>
        <p>
          I am an undergraduate researcher at Iowa State University (Honors Program), working toward
          four degrees in statistics, mathematics, data science and computer science.
        </p>
        <p>
          <em>
            My research focuses on AI/ML through different lenses: Probability, Stochastic Analysis,
            Numerical Analysis, and High Performance Computing.
          </em>
        </p>
        <p>
          When I am not running experiments, I fly. I am a private pilot with a high-performance
          endorsement, and I volunteer as a pilot on Pilots N Paws animal-rescue flights.
        </p>
        <div>
          <a href="/about" class="button icon">Read more <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="home-profile">
        <img
          src={portrait.src}
          srcset={`${portrait.srcSmall} 480w, ${portrait.src} 960w`}
          sizes="(min-width: 1200px) 30vw, (min-width: 770px) 42vw, 88vw"
          width={portrait.width}
          height={portrait.height}
          alt="Portrait of Akshat Valse"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</Base>
