---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import TitleBand from '../components/clarity/TitleBand.astro';
import Container from '../components/clarity/Container.astro';
import Icon from '../components/clarity/Icon.astro';

/**
 * HTML CV.
 *
 * The PDF remains the artifact a committee files; this page is what a crawler
 * reads and what opens without a download on a phone. The two are generated
 * from the same facts, so they must be edited together: cv/cv.tex is the source
 * of record for the PDF, this file for the page.
 *
 * The PDF carries a dated filename so a browser or proxy never serves a stale
 * copy after an update. Bump PDF_FILE here and the /cv.pdf redirect in
 * public/_redirects together.
 */
const PDF_FILE = 'akshat-valse-cv-2026-11.pdf';
const pdf = `/${PDF_FILE}`;
const hasPdf = existsSync(fileURLToPath(new URL(`../../public/${PDF_FILE}`, import.meta.url)));

const interests =
  'Applied probability for the systems that run machine learning: a renewal law for ' +
  'prefix-cache collapse in LLM agent serving, tested in registered experiments on real ' +
  'engines; Langevin sampling and its discretization, large deviations and rare-event ' +
  'simulation, the stability of learned PDE solvers, online calibration with early ' +
  'feedback, and the reliability of tool-using agents.';

type Course = [name: string, code?: string];

const inProgress: Course[] = [
  ['Foundations of Probability Theory, measure-theoretic', 'STAT 6541'],
  ['Advanced Topics in Machine Learning', 'COMS 6730'],
  ['Advanced Topics in Artificial Intelligence', 'COMS 6720'],
  ['Advanced Topics in High-Performance Computing', 'COMS 6250'],
];

const planned: Course[] = [
  ['Advanced Probability Theory'],
  ['Advanced Stochastic Processes'],
];

const completed: { group: string; courses: Course[] }[] = [
  {
    group: 'Probability and statistics',
    courses: [
      ['Theory of Probability and Statistics II', 'STAT 5430'],
      ['Stochastic Process Models', 'STAT 5540'],
      ['Empirical Methods for the Computational Sciences', 'STAT 5830'],
      ['Introduction to Multivariate Data Analysis', 'STAT 5750'],
      ['Introduction to Categorical Data Analysis', 'STAT 5770'],
      ['Introduction to Statistical Computing', 'STAT 5860'],
    ],
  },
  {
    group: 'Mathematics',
    courses: [
      ['Numerical Methods for Differential Equations', 'MATH 5810'],
      ['Analysis I', 'MATH 4140'],
      ['Introduction to Mathematical Finance', 'MATH 4430X'],
      ['Introduction to Partial Differential Equations', 'MATH 3850'],
      ['Theory of Linear Algebra, honors', 'MATH 3170'],
    ],
  },
  {
    group: 'Computing and machine learning',
    courses: [
      ['Concepts and Applications of Machine Learning, honors', 'DS 3030'],
      ['Introduction to the Design and Analysis of Algorithms', 'COMS 3110'],
      ['Software Development Practices', 'COMS 3090'],
    ],
  },
];

const manuscripts = [
  {
    title:
      'Large-Deviation-Guided Importance Sampling for Rare Events in the Mean-Field Join-the-Shortest-Queue Model',
    meta: 'With R. Wu. In preparation.',
  },
  {
    title: 'Langevin Dynamics and Transport-Coefficient Estimation for Molecular Systems',
    meta: 'With D. Herzog, O. Smith and D. Wu. In preparation.',
  },
  {
    title:
      'Stability Certificates for Cell-Average-Based Neural Network Solvers: von Neumann Analysis of Trained Flux Networks',
    meta: 'With M. Yang and J. Yan. In preparation.',
  },
  {
    title: 'Online Calibration of Neural Volatility Forecasts with Early, One-Sided Feedback',
    meta: 'In preparation.',
  },
];

const preprints = [
  {
    title: 'Inside the Trap: A Renewal Law for Prefix-Cache Collapse in LLM Agent Serving',
    meta: 'With A. Jannesari. arXiv:2611.08902, November 2026.',
    href: 'https://arxiv.org/abs/2611.08902',
    code: 'https://github.com/AkshatValse/surviving-llm-stampede',
  },
];

const research = [
  {
    title: 'Metastable Failures in Prefix-Cached LLM Agent Serving',
    dates: 'Aug. 2026 – present',
    role: 'Research project, Advanced Topics in High-Performance Computing (COMS 6250), Department of Computer Science, Iowa State University. Advisor: Prof. Ali Jannesari, SwAPP Lab.',
    bullets: [
      "Ran five registered paired tests on Iowa State's Nova HPC cluster through SLURM, on two serving engines (SGLang, vLLM), two GPUs (NVIDIA A100, H200) and two 7–8B models: a 200-session burst left the engine at zero hits to the end in all 30 burst runs (registered rule met at 9 of 10 rates), every matched no-burst run stayed good, and a client-side session cap prevented the trap in all 30 capped runs. In further registered tests the cap rescued 9 of 9 established traps at the same load without shedding a session.",
      "Proved that, along FIFO orbits, the cycles of an idealized fluid server on which every turn misses obey a linear renewal recursion whose Perron root, above the all-miss capacity, carries every trapped state to a known self-similar regime; with nothing fitted to trap data, the model matches 57 stuck runs retrospectively. Built the discrete-event simulator, the real-engine load generator and the SLURM job scripts, with each registered test committed to git before its jobs were submitted and every number in the paper traced to its source file and commit or SLURM job. Preprint on arXiv, November 2026; code, data and registrations are public.",
    ],
  },
  {
    title: 'Langevin Sampling and Diffusion Estimation for Molecular Systems',
    dates: 'May 2026 – present',
    role: 'Research Collaborator, Department of Mathematics, Iowa State University. Advisor: Prof. David Herzog. Funded by NSF award DMS-2246491.',
    bullets: [
      'Built an end-to-end Python simulation pipeline implementing MALA and projected Euler–Maruyama samplers for overdamped Langevin dynamics, staged from a one-dimensional periodic potential to a solvated ion in a three-dimensional Lennard-Jones bath; estimated self-diffusion and mobility coefficients from long-run trajectory data.',
      'Derived the closed-form Lifson–Jackson diffusivity D = 1/I₀(1)² ≈ 0.62386 as an exact benchmark and validated the estimators against it before scaling to three dimensions, where the pipeline reproduces published solvated-ion results.',
      "Author weekly technical reports, including a companion note supporting the group's CLT-based error analysis.",
    ],
  },
  {
    title: 'Large Deviation Theory for Rare-Event Analysis in Queueing Systems',
    dates: 'Nov. 2024 – present',
    role: "Undergraduate Research Fellow, Department of Mathematics, Iowa State University. Advisor: Prof. Ruoyu Wu. Dean's High Impact Undergraduate Research Award.",
    bullets: [
      'Developed the first importance-sampling methodology for rare-event estimation in the mean-field join-the-shortest-queue model, deriving state-dependent exponential tilting from the Budhiraja–Friedlander–Wu (2021) large-deviation rate function; stated a logarithmic-efficiency conjecture with a proof sketch via the Dupuis–Wang subsolution framework.',
      'Built a reproducible, performance-tuned Python simulation framework (Xoshiro256** with deterministic seeding) and validated it across 27 configurations (n ≤ 100, ρ ∈ {0.7, 0.9, 0.95}): estimates agree with crude Monte Carlo within 95% confidence intervals wherever crude Monte Carlo succeeds, and extend to probabilities as small as 10⁻³¹, where it fails entirely.',
      'Designed and benchmarked two heuristic tilting families (rate-reversal, level-weighted) with pilot-run selection; diagnosed over-tilting at extreme rarity through likelihood-ratio calibration statistics, motivating the ongoing computation of the optimal state-dependent tilt.',
    ],
  },
  {
    title: 'Stability Analysis of Cell-Average Neural Networks for PDEs',
    dates: 'May 2026 – present',
    role: 'Undergraduate Researcher, Department of Mathematics, Iowa State University. Advisor: Prof. Jue Yan. Funded by the NSF D4 NRT. Joint with Mengyuan Yang.',
    bullets: [
      'Adapting von Neumann stability analysis to neural-network PDE solvers: deriving the linearized amplification factor of the learned time-stepping scheme and characterizing how perturbations propagate through it, toward stability conditions on the trained weights analogous to those of classical finite-difference methods.',
      "Reimplemented the group's solver in Python to enable systematic stability experiments across schemes and step sizes.",
    ],
  },
  {
    title: 'Calibrating Volatility Forecasts with Early, One-Sided Feedback',
    dates: 'Aug. 2026 – present',
    role: 'Research project, Advanced Topics in Machine Learning (COMS 6730), Department of Computer Science, Iowa State University. Advisor: Prof. Hongyang Gao.',
    bullets: [
      'A forecast of a cumulative quantity is scored only when its horizon ends, but its increments are non-negative, so a miss becomes certain the moment the running sum crosses the issued bound. Designed a model-agnostic calibration layer over any quantile forecaster that credits those certain early misses and keeps explicit accounts of forecasts still pending; drafted a proof of its long-run coverage guarantee under early crediting, bounded correction and missing data, and checked the consequences of the guarantee numerically in adversarial runs.',
      'Built a leakage-audited data pipeline (5-minute spot bars, 2020–2025, with a sealed and hashed test set), a regime-shift simulation study with exact oracle quantiles and pre-registered hypotheses, and delayed-feedback conformal and classical volatility baselines, including a temporal convolutional network with training workflows for Apple-silicon and HPC GPUs. Paper in preparation.',
    ],
  },
  {
    title: 'Reliability of Tool-Using LLM Agents',
    dates: 'Aug. 2026 – present',
    role: 'Research project, Advanced Topics in Artificial Intelligence (COMS 6720), Department of Computer Science, Iowa State University. Advisor: Prof. Yang Li.',
    bullets: [
      'When an agent stalls, when is restarting it worth more than waiting, and how can the probability of a failure too rare for direct simulation be estimated? Two planned, pre-registered pilots on real agents, one on restart policies and one on rare failures, with the direction still being chosen.',
    ],
  },
];

const awards = [
  "Dean's High Impact Undergraduate Research Award, Iowa State University, 2026.",
  'Schillmoeller Family Scholarship in Statistics.',
  'Mead Fund Award in Statistics.',
  'James L. Cornette Mathematics and Interdisciplinary Studies Award.',
  "Dean's List, every semester.",
];

const service = [
  'Treasurer, Iowa State Data Science Club, 2025 – present. Secured $60,000+ in funding supporting 130+ members.',
  'Research Ambassador, Iowa State University Honors Program.',
  'FAA Private Pilot Certificate; high-performance endorsement, 2025. Volunteer pilot and recruitment advisor, Pilots N Paws animal-rescue flights.',
];

const skills = [
  {
    label: 'Languages and tools',
    text:
      'PyTorch and CUDA for neural-network and GPU-accelerated simulation; Python (NumPy, SciPy, pandas, scikit-learn, matplotlib, asyncio); SLURM on GPU clusters and LLM serving engines (SGLang, vLLM); R; LaTeX; git.',
  },
  {
    label: 'Methods',
    text:
      'Measure-theoretic probability and stochastic differential equations; MCMC (MALA, Metropolis–Hastings) and importance sampling; large-deviation asymptotics; numerical analysis of time-stepping schemes and von Neumann stability; discrete-event simulation and queueing models; online conformal calibration; reproducible computation with recorded seeds, parameter sidecars and pre-registered predictions, so every figure regenerates from saved results.',
  },
];

/** Project page for each research-experience entry, in CV order. */
const projectSlugs = ['inside-the-trap', 'langevin', 'large-deviations', 'neural-pde-stability', 'online-calibration', 'agent-reliability'];

---

<Base
  title="CV · Akshat Sachin Valse"
  breadcrumbs={[{ name: 'CV', path: '/cv' }]}
  description="Curriculum vitae of Akshat Sachin Valse, undergraduate researcher at Iowa State University in applied probability for the systems that run machine learning."
  toc
>
  <TitleBand>
    <h1 class="title">Akshat Sachin Valse</h1>
    <p class="author">Curriculum vitae · updated November 2026</p>
    <p class="abstract">{interests}</p>
    <div class="info">
      <div>
        {hasPdf && <><a href={pdf} class="button icon" style="background-color: rgba(255, 255, 255, 0.2)">Download PDF <Icon name="pdf" /></a> &nbsp;&nbsp;</>}
        <a href="mailto:avalse@iastate.edu" class="button icon" style="background-color: rgba(255, 255, 255, 0.2)">Email <Icon name="mail" /></a> &nbsp;&nbsp;
        <a href="https://github.com/AkshatValse" rel="me" class="button icon" style="background-color: rgba(255, 255, 255, 0.2)">GitHub <Icon name="github" /></a>
      </div>
    </div>
    <Fragment slot="info">Iowa State University, Honors · B.S. expected May 2028</Fragment>
  </TitleBand>

  <Container first id="education">
    <h1>Education</h1>
    <h2>Iowa State University, Honors Program</h2>
    <p class="text">
      Aug. 2024 – May 2028 (expected) · Cumulative GPA 3.86 / 4.00<br />
      B.S. Statistics · B.S. Mathematics · B.A. Computer Science · B.S. Data Science
    </p>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>In progress, Fall 2026 (all four at the PhD level, 6000-series)</th><th>Course</th></tr></thead>
        <tbody>{inProgress.map(([name, code]) => <tr><td>{name}</td><td>{code}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="text"><b>Planned, Spring 2027:</b> {planned.map(([name]) => name).join(' · ')}.</p>
    {completed.map((g) => (
      <div class="table-wrapper">
        <table>
          <thead><tr><th>Completed · {g.group}</th><th>Course</th></tr></thead>
          <tbody>{g.courses.map(([name, code]) => <tr><td>{name}</td><td>{code}</td></tr>)}</tbody>
        </table>
      </div>
    ))}
  </Container>

  <Container id="preprints">
    <h1>Preprints</h1>
    {preprints.map((p) => (
      <>
        <p class="text"><b>{p.title}.</b><br />{p.meta}</p>
        <p class="text">
          <a href={p.href} class="button icon">Paper <Icon name="paper" /></a> &nbsp;&nbsp;
          <a href={p.code} class="button icon">Code, data, registrations <Icon name="code" /></a> &nbsp;&nbsp;
          <a href="/research/inside-the-trap" class="button icon">Project page <Icon name="arrow" /></a>
        </p>
      </>
    ))}
  </Container>

  <Container id="research">
    <h1>Research experience</h1>
    {research.map((r, i) => (
      <>
        <h2><a href={`/research/${projectSlugs[i]}`}>{r.title}</a></h2>
        <p class="text"><b>{r.dates}.</b> {r.role}</p>
        <ul>{r.bullets.map((b) => <li><p class="text">{b}</p></li>)}</ul>
      </>
    ))}
  </Container>

  <Container id="manuscripts">
    <h1>Manuscripts in preparation</h1>
    <ul>{manuscripts.map((m) => <li><p class="text"><b>{m.title}.</b> {m.meta}</p></li>)}</ul>
  </Container>

  <Container id="awards">
    <h1>Awards and honors</h1>
    <ul>{awards.map((a) => <li><p class="text">{a}</p></li>)}</ul>
  </Container>

  <Container id="service">
    <h1>Leadership and service</h1>
    <ul>{service.map((s) => <li><p class="text">{s}</p></li>)}</ul>
  </Container>

  <Container id="skills">
    <h1>Technical skills</h1>
    {skills.map((s) => (<><h2>{s.label}</h2><p class="text">{s.text}</p></>))}
  </Container>
</Base>
