---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes
    .filter((n) => !n.data.draft)
    .map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: note.data.title,
  abstract: note.data.summary,
  datePublished: note.data.date.toISOString().slice(0, 10),
  ...(note.data.updated && { dateModified: note.data.updated.toISOString().slice(0, 10) }),
  author: {
    '@type': 'Person',
    name: 'Akshat Sachin Valse',
    url: Astro.site?.href,
    affiliation: { '@type': 'CollegeOrUniversity', name: 'Iowa State University' },
  },
  inLanguage: 'en',
  isAccessibleForFree: true,
  mainEntityOfPage: new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href,
  image: new URL(`/og/${note.id}.png`, Astro.site).href,
  publisher: { '@type': 'Person', name: 'Akshat Sachin Valse' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Notes',
      item: new URL('/notes', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: note.data.title,
      item: new URL(`/notes/${note.id}`, Astro.site).href,
    },
  ],
};
---


<Base
  title={`${note.data.title} · Akshat Valse`}
  description={note.data.summary}
  ogType="article"
  ogImage={`/og/${note.id}.png`}
  ogImageAlt={`${note.data.title} — a note by Akshat Sachin Valse, shown above its figure.`}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="section shell">
    <div class="row">
      <div class="rail">
        <span class="rail-label">note</span>
        <hr class="rail-rule" />
        <dl>
          <dt>Posted</dt><dd>{fmt(note.data.date)}</dd>
          {note.data.updated && (<><dt>Updated</dt><dd>{fmt(note.data.updated)}</dd></>)}
          {note.data.pdf && (<><dt>PDF</dt><dd><a href={note.data.pdf}>Download</a></dd></>)}
        </dl>
        <hr class="rail-rule" />
        <p><a href="/notes">← All notes</a></p>
      </div>
      <div class="prose">
        <h1 class="page-title">{note.data.title}</h1>
        <p class="lede">{note.data.summary}</p>
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono), monospace;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    margin: 1.5rem 0;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th), .prose :global(td) {
    border-bottom: 1px solid var(--rule);
    padding: 0.35rem 0.7rem 0.35rem 0;
    text-align: left;
  }
  .prose :global(th) { color: var(--ink-2); font-weight: 500; }
  .prose :global(thead th) { border-bottom-width: 1px; }
</style>
