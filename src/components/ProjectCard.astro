---
/**
 * A project as Clarity would show one inside a `columns-N` grid: an image
 * (linked) and a caption under it.
 */
import type { Project } from '../data/projects';
import ProjectThumb from './ProjectThumb.astro';
interface Props { project: Project; idSuffix?: string }
const { project: p, idSuffix = 'c' } = Astro.props;
---

<div>
  <a class="tile" href={`/research/${p.slug}`} aria-label={p.title}>
    <div class="thumb"><ProjectThumb project={p} idSuffix={idSuffix} /></div>
  </a>
  <p class="caption">
    <b><a href={`/research/${p.slug}`}>{p.short}</a></b> · {p.advisor} · {p.status}<br />
    {p.oneLiner}
  </p>
</div>
