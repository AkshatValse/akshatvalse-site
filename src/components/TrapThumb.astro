---
/**
 * Static two-lane miniature of Fig. 1 (the trap and the rescue), drawn at
 * build time from the same seeded run the live figure replays. Used for cards
 * and covers; it never runs a simulation in the browser.
 */
import { trapFacts } from '../sim/trap-facts.js';
import { laneGeometry } from '../sim/trap-poster.js';

interface Props { id: string; labels?: boolean }
const { id, labels = true } = Astro.props;
const f = trapFacts();
const lanes = [laneGeometry(f.bins[0], f.ymax), laneGeometry(f.bins[1], f.ymax)];
const H = 100, gap = 14;
---

<svg class="trap-thumb" viewBox={`0 0 ${lanes[0].nBins} ${2 * H + gap}`} preserveAspectRatio="none" role="img"
  aria-label="Two simulated serving engines after the same burst of agent traffic: without a cap the cache hit fraction stays at zero; with a session cap it recovers.">
  <defs>
    {lanes.map((l, j) => (['light', 'dark'] as const).map((s) => (
      <linearGradient id={`${id}-g${j}-${s}`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={l.nBins} y2="0">
        {l[s].map((st) => st.c === null
          ? <stop offset={st.o.toFixed(5)} style="stop-color: var(--sim-contour)" />
          : <stop offset={st.o.toFixed(5)} stop-color={st.c} />)}
      </linearGradient>
    )))}
  </defs>
  {lanes.map((l, j) => (
    <g transform={`translate(0 ${j * (H + gap)})`}>
      <path class={`tt-area tt-${j}`} d={l.area} style={`--g-light: url(#${id}-g${j}-light); --g-dark: url(#${id}-g${j}-dark)`} />
      <path class="tt-line" d={l.line} vector-effect="non-scaling-stroke" />
    </g>
  ))}
</svg>
{labels && (
  <span class="tt-label tt-l0">No cap · trapped</span>
  <span class="tt-label tt-l1">Session cap · recovers</span>
)}

<style>
  .trap-thumb { position: absolute; inset: 8% 4% 6%; width: 92%; height: 86%; display: block; }
  .tt-area { fill: var(--g-light); }
  @media (prefers-color-scheme: dark) { .tt-area { fill: var(--g-dark); } }
  .tt-line { fill: none; stroke: var(--ink-2); stroke-width: 1; }
  .tt-label {
    position: absolute; left: 5%; z-index: 2;
    font-family: var(--font-mono), monospace; font-size: 0.68rem; line-height: 1.3;
    color: var(--ink); background: var(--ground); border: 1px solid var(--rule);
    padding: 0.1rem 0.4rem; border-radius: 4px;
  }
  .tt-l0 { top: 9%; }
  .tt-l1 { top: 55%; }
</style>
