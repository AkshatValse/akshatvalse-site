/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/poster/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800

/clarity/*
  Cache-Control: public, max-age=604800

/research/:slug/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800
